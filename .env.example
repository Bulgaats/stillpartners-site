# Required for Supabase Auth, database, storage, RLS, and dashboard access.
# Public pages can render locally without these, but forms/auth/dashboard need them.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Required only for server-only admin jobs and edge functions.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Required for OAuth redirect URLs and generated links.
NEXT_PUBLIC_SITE_URL=https://www.stillpartners.net

# Server-only branding and payment details used on client invoice PDFs.
# Configure these in Vercel; never prefix bank details with NEXT_PUBLIC_.
STILL_PARTNERS_INVOICE_PHONE=your-business-phone
STILL_PARTNERS_INVOICE_EMAIL=work@stillpartners.net
STILL_PARTNERS_INVOICE_ADDRESS=your-business-address
STILL_PARTNERS_BANK_NAME=your-bank-name
STILL_PARTNERS_BANK_BSB=your-bsb
STILL_PARTNERS_BANK_ACCOUNT_NUMBER=your-account-number
STILL_PARTNERS_BANK_ACCOUNT_NAME=Still Partners
